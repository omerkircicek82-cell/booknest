<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <appSettings>
    <!-- ADMIN ŞİFRESİ: yayına almadan önce mutlaka değiştir -->
    <add key="AdminPassword" value="" />
  </appSettings>
  <system.web>
    <httpRuntime targetFramework="4.5" maxRequestLength="6144" executionTimeout="120" />
    <compilation targetFramework="4.5" />
    <httpCookies httpOnlyCookies="true" />
  </system.web>
  <system.webServer>
    <defaultDocument enabled="true"><files><clear /><add value="index.html" /></files></defaultDocument>
    <staticContent>
      <remove fileExtension=".json" /><mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webp" /><mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
    <security><requestFiltering><requestLimits maxAllowedContentLength="6291456" /><hiddenSegments><add segment="content.bak.json" /><add segment=".env" /><add segment=".git" /><add segment=".data" /><add segment="lib" /><add segment="test" /></hiddenSegments></requestFiltering></security>
  </system.webServer>
</configuration>
